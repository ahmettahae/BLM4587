# Bu dosyayı .env adıyla kopyalayıp kendi değerlerini yaz. .env depoya girmez.
# Biçim: postgresql+psycopg://KULLANICI:SIFRE@SUNUCU:PORT/VERITABANI
DATABASE_URL=postgresql+psycopg://postgres:SIFRENI_BURAYA_YAZ@localhost:5432/kitapligim
# JWT imza anahtarı: uzun ve rastgele olmalı. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=BURAYA_UZUN_RASTGELE_BIR_DEGER_YAZ
